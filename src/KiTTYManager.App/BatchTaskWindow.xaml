<Window x:Class="KiTTYManager.App.BatchTaskWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KiTTYManager.App" Style="{StaticResource {x:Type Window}}" Title="Массовые задачи" Width="1100" Height="760" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="TaskModeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="TaskModeBox_SelectionChanged"><ComboBoxItem Content="Конструктор" Tag="Constructor"/><ComboBoxItem Content="Ansible" Tag="Ansible"/></ComboBox><TextBlock x:Name="TaskNameLabel" Grid.Column="2" Text="Название задачи:" VerticalAlignment="Center" Margin="18,0,8,0"/><TextBox x:Name="TaskNameBox" Grid.Column="3"/><Button x:Name="AnsibleReadinessButton" Grid.Column="4" Content="Проверить готовность Ansible" Click="CheckAnsibleReadiness_Click" Margin="12,0,0,0" Visibility="Collapsed"/></Grid>
<TabControl x:Name="WizardTabs" Grid.Row="1" SelectionChanged="WizardTabs_SelectionChanged">
<TabItem Header="Начало"><StackPanel Margin="18" MaxWidth="700" HorizontalAlignment="Left"><TextBlock Text="Что вы хотите сделать?" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Мастер проведёт по серверам, действиям, файлам, туннелям и запуску." Opacity="0.75" Margin="0,6,0,22"/><Button Height="55" Click="NewTask_Click" Content="Создать новую задачу"/><TextBlock Text="Настроить всё с нуля по шагам." Opacity="0.7" Margin="12,2,0,14"/><Button Height="55" Click="Templates_Click" Content="Выбрать готовый шаблон"/><TextBlock Text="Найти сохранённый шаблон, открыть или подготовить к запуску." Opacity="0.7" Margin="12,2,0,14"/><Button Height="55" Click="Import_Click" Content="Открыть задачу из файла"/><TextBlock Text="Импортировать .kmtask или task.yaml." Opacity="0.7" Margin="12,2,0,0"/></StackPanel></TabItem>
<TabItem Header="1. Серверы"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Шаг 1 — выберите серверы и права" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Нажимайте на всю строку. Для первого теста выберите один безопасный сервер." Opacity="0.75" Margin="0,5,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ServerSearchBox" ToolTip="Поиск по имени или адресу" TextChanged="ServerSearchBox_TextChanged"/><TextBlock x:Name="SelectedServersText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" MaxWidth="430" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="60000"/></Grid><WrapPanel Margin="0,8,0,0"><Button Click="SelectAllServers_Click" Margin="0,0,8,0">Выбрать найденные</Button><Button Click="ClearServers_Click">Снять весь выбор</Button></WrapPanel></StackPanel><GroupBox Grid.Row="1" Header="Как выполнять команды" Margin="0,10,0,0"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><ComboBox x:Name="PrivilegeModeBox" SelectedIndex="0" Width="370"><ComboBoxItem Content="Без повышения прав" Tag="SessionUser"/><ComboBoxItem Content="С повышением прав (root, если задано)" Tag="AlwaysBecome"/></ComboBox><TextBlock Grid.Column="1" Text="Повышение использует sudo/su, настроенные в сессии (поля «Повышение прав» и «Root-пароль»). Если вход и так сразу под root — оставьте первый вариант." TextWrapping="Wrap" Opacity="0.7" Margin="10,0"/><TextBlock Grid.Column="2" Text="Рабочая папка:" VerticalAlignment="Center"/><TextBox x:Name="WorkingDirectoryBox" Grid.Column="3" ToolTip="Например /opt/app. Каждая команда сначала переходит в эту папку. У отдельного действия можно указать свою папку."/></Grid></GroupBox><GroupBox x:Name="ServerSelector" Grid.Row="2" Header="Выбранные серверы отмечены галочкой" Margin="0,10,0,0"><DataGrid x:Name="ServersGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MouseLeftButtonUp="ServersGrid_MouseLeftButtonUp"><DataGrid.Columns><DataGridTemplateColumn Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Сессия" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Сервер" Binding="{Binding Host}" Width="220"/><DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="180"/></DataGrid.Columns></DataGrid></GroupBox></Grid></TabItem>
<TabItem Header="2. Действия и файлы"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Шаг 2 — что сделать на серверах" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Действия идут сверху вниз. Файлы добавляются действием «Загрузить файл или папку»." Opacity="0.75" Margin="0,5,0,12"/><WrapPanel><Button Click="AddStep_Click" Style="{StaticResource SuccessButton}" Margin="0,0,8,0">Добавить действие…</Button><Button Click="EditStep_Click" Margin="0,0,8,0">Изменить…</Button><Button Click="MoveStepUp_Click" Margin="0,0,8,0">Выше ↑</Button><Button Click="MoveStepDown_Click" Margin="0,0,8,0">Ниже ↓</Button><Button Click="DeleteStep_Click" Style="{StaticResource DangerButton}" Margin="0,0,8,0">Удалить выбранные</Button><Button Click="SelectAllSteps_Click" Margin="0,0,8,0">Выбрать все</Button><Button Click="DeselectSteps_Click">Снять выделение</Button></WrapPanel><TextBlock Text="Действия выполняются по порядку сверху вниз. Ctrl+клик или Shift+клик — выбрать несколько. Перетаскивание мышью меняет порядок." Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><DataGrid x:Name="StepsGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" MouseDoubleClick="StepsGrid_MouseDoubleClick" PreviewMouseLeftButtonDown="StepsGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="StepsGrid_PreviewMouseMove" PreviewMouseLeftButtonUp="StepsGrid_PreviewMouseLeftButtonUp" AllowDrop="True"><DataGrid.Columns><DataGridTemplateColumn Width="46"><DataGridTemplateColumn.Header><CheckBox x:Name="SelectAllStepsCheck" IsThreeState="True" Click="SelectAllStepsCheck_Click" ToolTip="Отметить все действия"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Что сделать" Width="210" Binding="{Binding KindDisplay}"/><DataGridTextColumn Header="Название" Width="170" Binding="{Binding Name}"/><DataGridTextColumn Header="Подробности" Width="*" Binding="{Binding Summary}"/><DataGridTemplateColumn Width="90"><DataGridTemplateColumn.Header><TextBlock Text="Не критично" ToolTip="Ошибка такого действия не останавливает сервер: следующие действия всё равно выполняются."/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding ContinueOnError, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="3. Туннели"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Шаг 3 — нужны ли SSH-туннели?" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Если не нужны — нажмите «Далее». Local открывает порт на вашем ПК. Remote открывает порт на сервере и ведёт к адресу со стороны вашего ПК." TextWrapping="Wrap" Opacity="0.75" Margin="0,5,0,10"/><CheckBox x:Name="AutoReconnectBox" Content="Восстанавливать туннели после обрыва" IsChecked="True"/><CheckBox x:Name="KeepTunnelsBox" Content="Держать туннели открытыми после завершения всех шагов" Margin="0,6,0,0" ToolTip="По умолчанию туннели закрываются, когда все шаги выполнены, и задача завершается. Включите, если нужно пользоваться туннелем после выполнения задачи — тогда соединение останется до нажатия «Остановить»."/><WrapPanel Margin="0,10,0,0"><Button Click="AddTunnel_Click" Style="{StaticResource SuccessButton}" Margin="0,0,8,0">Добавить туннель…</Button><Button Click="EditTunnel_Click" Margin="0,0,8,0">Изменить…</Button><Button Click="DeleteTunnel_Click" Style="{StaticResource DangerButton}">Удалить</Button></WrapPanel></StackPanel><GroupBox x:Name="TunnelEditor" Grid.Row="1" Header="Добавленные туннели" Margin="0,10,0,0"><DataGrid x:Name="TunnelsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MouseDoubleClick="TunnelsGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Тип" Binding="{Binding KindDisplay}" Width="180"/><DataGridTextColumn Header="Откуда → куда" Binding="{Binding Summary}" Width="*"/><DataGridTextColumn Header="Только для" Binding="{Binding ServerDisplay}" Width="220"/></DataGrid.Columns></DataGrid></GroupBox></Grid></TabItem>
<TabItem Header="4. Проверка и запуск"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Шаг 4 — проверьте и запустите" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ReviewSummary" TextWrapping="Wrap" Opacity="0.8" Margin="0,5,0,12"/><WrapPanel><Button Click="SaveTemplate_Click" Margin="0,0,8,0">Сохранить как шаблон…</Button><Button Click="Export_Click">Сохранить задачу как файл…</Button></WrapPanel></StackPanel><Grid Grid.Row="1" Margin="0,8"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><WrapPanel><TextBlock Text="Если один сервер завершился ошибкой:" VerticalAlignment="Center"/><ComboBox x:Name="FailureModeBox" Width="280" Margin="8,0" SelectedIndex="0"><ComboBoxItem Content="Продолжить на остальных" Tag="Continue"/><ComboBoxItem Content="Остановить всё после первой ошибки" Tag="StopStartingNewServers"/></ComboBox></WrapPanel><Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="Progress" Height="18"/><TextBlock x:Name="StatusCounts" Grid.Column="1" Margin="12,0,0,0"/></Grid></Grid><WrapPanel Grid.Row="2"><TextBlock Text="Показать журнал:" VerticalAlignment="Center"/><ComboBox x:Name="LogServerFilter" Width="220" Margin="8,0,8,0" SelectionChanged="LogFilter_Changed"/><Button x:Name="LogConfigButton" Style="{StaticResource ComboBoxButtonStyle}" Width="235" Margin="0,0,8,0" Click="LogConfigButton_Click"><TextBlock x:Name="LogConfigButtonText" Text="Вид журнала: Все уровни" TextTrimming="CharacterEllipsis"/><Button.ContextMenu><ContextMenu x:Name="LogViewContextMenu"><MenuItem Header="УРОВЕНЬ СООБЩЕНИЙ" IsEnabled="False" FontWeight="SemiBold" Foreground="#888888"/><MenuItem x:Name="LogLevelAllMenu" Header="Все уровни" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="LogLevelOption_Click"/><MenuItem x:Name="LogLevelInfoMenu" Header="Только Info" IsCheckable="True" StaysOpenOnClick="True" Click="LogLevelOption_Click"/><MenuItem x:Name="LogLevelWarnMenu" Header="Предупреждения и ошибки" IsCheckable="True" StaysOpenOnClick="True" Click="LogLevelOption_Click"/><MenuItem x:Name="LogLevelErrorMenu" Header="Только ошибки" IsCheckable="True" StaysOpenOnClick="True" Click="LogLevelOption_Click"/><Separator/><MenuItem Header="ОТОБРАЖЕНИЕ" IsEnabled="False" FontWeight="SemiBold" Foreground="#888888"/><MenuItem x:Name="HideTimeMenu" Header="Скрыть дату и время" IsCheckable="True" StaysOpenOnClick="True" Click="LogViewOption_Click"/><MenuItem x:Name="ConsoleOnlyMenu" Header="Только вывод консоли" IsCheckable="True" StaysOpenOnClick="True" Click="LogViewOption_Click"/><MenuItem x:Name="HidePrefixMenu" Header="Скрыть префиксы источника и шага" IsCheckable="True" StaysOpenOnClick="True" Click="LogViewOption_Click"/></ContextMenu></Button.ContextMenu></Button><Button Content="Открыть журнал сервера отдельно" Click="OpenServerLog_Click" Margin="0,0,8,0"/><Button Content="Копировать журнал" Click="CopyLog_Click" Margin="0,0,8,0"/><CheckBox x:Name="LogWrapBox" Content="Перенос строк" VerticalAlignment="Center" Click="LogWrapBox_Click"/></WrapPanel><TextBox x:Name="LogBox" Grid.Row="3" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></Grid></TabItem>
</TabControl>
<Grid x:Name="AnsiblePanel" Grid.Row="1" Visibility="Collapsed">
<TabControl x:Name="AnsibleWizardTabs" SelectionChanged="AnsibleWizardTabs_SelectionChanged">
<TabItem Header="1. Playbook и параметры"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Шаг 1 — выберите playbook" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Playbook и его папка копируются во временную Linux VM с сохранением относительных путей. Пути в YAML задавайте относительно playbook. delegate_to: localhost означает VM, не Windows-компьютер." TextWrapping="Wrap" Opacity="0.75" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AnsiblePlaybookBox" IsReadOnly="True" ToolTip="Главный YAML playbook"/><Button Grid.Column="1" Click="BrowseAnsiblePlaybook_Click" Content="Выбрать playbook…" Margin="8,0,0,0"/></Grid><WrapPanel Margin="0,10,0,0"><TextBlock Text="Vault-пароль:" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Пароль для расшифровки данных Ansible Vault. Оставьте пустым, если playbook не использует Vault."/><local:SecretBox x:Name="AnsibleVaultPasswordBox" Width="280" ToolTip="Пароль для зашифрованных через Ansible Vault переменных или файлов. Не нужен обычным playbook."/></WrapPanel></StackPanel><Grid Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Папка выгрузок на ПК:" VerticalAlignment="Center"/><TextBox x:Name="AnsibleDownloadFolderBox" Grid.Column="1" Margin="8,0" IsReadOnly="True"/><Button Grid.Column="2" Click="BrowseAnsibleDownloadFolder_Click">Выбрать папку…</Button></Grid></Grid></TabItem>
<TabItem Header="2. Серверы"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Шаг 2 — выберите серверы" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Поиск, группы и выбор строк работают так же, как на карте связей. Маршруты строятся не более чем по 5 одновременно." Opacity="0.75" Margin="0,5,0,8" TextWrapping="Wrap"/><TextBlock x:Name="AnsibleSelectedServersText" FontWeight="SemiBold" MaxWidth="650" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="60000" Margin="0,0,0,8"/></StackPanel><local:ServerSelectionList x:Name="AnsibleServerSelector" Grid.Row="1"/></Grid></TabItem>
<TabItem Header="3. Туннели"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Шаг 3 — нужны ли SSH-туннели?" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Настройки и направления совпадают с туннелями конструктора массовых задач. Если туннели не нужны — нажмите «Далее»." TextWrapping="Wrap" Opacity="0.75" Margin="0,5,0,10"/><WrapPanel><Button Click="AddAnsibleTunnel_Click" Style="{StaticResource SuccessButton}" Margin="0,0,8,0">Добавить туннель…</Button><Button Click="EditAnsibleTunnel_Click" Margin="0,0,8,0">Изменить…</Button><Button Click="DeleteAnsibleTunnel_Click" Style="{StaticResource DangerButton}">Удалить</Button></WrapPanel></StackPanel><GroupBox Grid.Row="1" Header="Туннели Ansible" Margin="0,10,0,0"><DataGrid x:Name="AnsibleTunnelsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MouseDoubleClick="AnsibleTunnelsGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Тип" Binding="{Binding KindDisplay}" Width="180"/><DataGridTextColumn Header="Откуда → куда" Binding="{Binding Summary}" Width="*"/><DataGridTextColumn Header="Только для" Binding="{Binding ServerDisplay}" Width="220"/></DataGrid.Columns></DataGrid></GroupBox></Grid></TabItem>
<TabItem Header="4. Запуск и журнал"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Шаг 4 — запуск и журнал" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="AnsibleReviewText" Margin="0,5,0,8" Opacity="0.75" TextWrapping="Wrap"/><WrapPanel><TextBlock Text="Подробность запуска:" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="AnsibleVerbosityBox" Width="220" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="Обычная (без -v)" Tag="0"/><ComboBoxItem Content="Подробная (-v)" Tag="1"/><ComboBoxItem Content="Более подробная (-vv)" Tag="2"/><ComboBoxItem Content="Отладочная (-vvv)" Tag="3"/><ComboBoxItem Content="Максимальная (-vvvv)" Tag="4"/></ComboBox><Button x:Name="AnsibleLogConfigButton" Style="{StaticResource ComboBoxButtonStyle}" Width="240" Margin="0,0,8,0" Click="AnsibleLogConfigButton_Click"><TextBlock x:Name="AnsibleLogConfigButtonText" Text="Вид журнала: Все сообщения" TextTrimming="CharacterEllipsis"/><Button.ContextMenu><ContextMenu x:Name="AnsibleLogViewContextMenu"><MenuItem Header="УРОВЕНЬ СООБЩЕНИЙ" IsEnabled="False" FontWeight="SemiBold" Foreground="#888888"/><MenuItem x:Name="AnsibleLogAllMenu" Header="Все сообщения" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="AnsibleLogLevelOption_Click"/><MenuItem x:Name="AnsibleLogWarnErrorMenu" Header="Только ошибки и предупреждения" IsCheckable="True" StaysOpenOnClick="True" Click="AnsibleLogLevelOption_Click"/><Separator/><MenuItem Header="ОТОБРАЖЕНИЕ" IsEnabled="False" FontWeight="SemiBold" Foreground="#888888"/><MenuItem x:Name="AnsibleHideTimeMenu" Header="Скрыть дату и время" IsCheckable="True" StaysOpenOnClick="True" Click="AnsibleLogViewOption_Click"/><MenuItem x:Name="AnsibleConsoleOnlyMenu" Header="Только вывод консоли" IsCheckable="True" StaysOpenOnClick="True" Click="AnsibleLogViewOption_Click"/></ContextMenu></Button.ContextMenu></Button><Button Content="Показать состав запуска" Click="PreviewAnsible_Click" Margin="0,0,8,0"/><Button Content="Копировать журнал" Click="CopyAnsibleLog_Click" Margin="0,0,8,0"/><CheckBox x:Name="AnsibleLogWrapBox" Content="Перенос строк" VerticalAlignment="Center" Click="AnsibleLogWrapBox_Click"/></WrapPanel><TextBox x:Name="AnsibleCompositionText" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MaxHeight="154" MinHeight="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></StackPanel><ProgressBar x:Name="AnsibleProgress" Grid.Row="1" Height="18" Margin="0,10"/><TextBox x:Name="AnsibleLogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></Grid></TabItem>
</TabControl></Grid>
<Grid Grid.Row="2" Margin="0,12,0,0"><WrapPanel><Button x:Name="PreviousButton" Click="Previous_Click" Margin="0,0,8,0">← Назад</Button><Button x:Name="NextButton" Click="Next_Click">Далее →</Button></WrapPanel><WrapPanel HorizontalAlignment="Right"><Button x:Name="RunButton" Click="Run_Click" Margin="0,0,8,0">Запустить</Button><Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False" Margin="0,0,8,0">Остановить</Button><Button x:Name="SaveLogButton" Click="SaveLog_Click" IsEnabled="False" Margin="0,0,8,0">Сохранить журнал</Button><Button x:Name="SaveSeparateLogsButton" Click="SaveSeparateLogs_Click" IsEnabled="False" Margin="0,0,8,0">Сохранить журналы по серверам</Button><Button Click="Close_Click">Закрыть</Button></WrapPanel></Grid>
</Grid></Window>
