<Window x:Class="KiTTYManager.App.TunnelForwardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Проброс SSH-туннеля"
        Width="600" Height="520" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Настройка SSH-туннеля" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="ServerInfoText" Text="Сессия: " Opacity="0.75" Margin="0,4,0,4"/>
      <TextBlock x:Name="KindHelp" TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,4"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Тип" VerticalAlignment="Center"/>
        <ComboBox x:Name="KindBox" Grid.Column="1" Margin="0,4,0,8" SelectionChanged="KindBox_SelectionChanged">
          <ComboBoxItem Content="Local — порт на моём ПК" Tag="Local"/>
          <ComboBoxItem Content="Remote — порт на сервере" Tag="Remote"/>
          <ComboBoxItem Content="Dynamic — локальный SOCKS5" Tag="Dynamic"/>
        </ComboBox>

        <TextBlock x:Name="BindHostLabel" Grid.Row="1" Text="Где открыть порт" VerticalAlignment="Center"/>
        <TextBox x:Name="BindHostBox" Grid.Row="1" Grid.Column="1" Text="127.0.0.1" Margin="0,4,0,8"/>

        <TextBlock x:Name="BindPortLabel" Grid.Row="2" Text="Какой порт открыть" VerticalAlignment="Center"/>
        <TextBox x:Name="BindPortBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,8"/>

        <TextBlock x:Name="DestinationHostLabel" Grid.Row="3" Text="Куда вести трафик (адрес)" VerticalAlignment="Center"/>
        <TextBox x:Name="DestinationHostBox" Grid.Row="3" Grid.Column="1" Margin="0,4,0,8"/>

        <TextBlock x:Name="DestinationPortLabel" Grid.Row="4" Text="Куда вести трафик (порт)" VerticalAlignment="Center"/>
        <TextBox x:Name="DestinationPortBox" Grid.Row="4" Grid.Column="1" Margin="0,4,0,8"/>

        <TextBlock x:Name="FieldsHelp" Grid.Row="5" Grid.ColumnSpan="2" TextWrapping="Wrap"
                   Opacity="0.7" Margin="0,4,0,8"/>
      </Grid>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button IsCancel="True" Content="Отмена" Margin="0,0,8,0"/>
      <Button IsDefault="True" Content="Прокинуть" Style="{StaticResource PrimaryButton}" Click="Forward_Click"/>
    </StackPanel>
  </Grid>
</Window>
