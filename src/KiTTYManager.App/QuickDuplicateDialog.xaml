<Window x:Class="KiTTYManager.App.QuickDuplicateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KiTTYManager.App"
        Title="Быстрый дубль" Width="900" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl>
      <TabItem Header="Основное">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Название" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1"/>
          <TextBlock Grid.Row="1" Text="IP / host" VerticalAlignment="Center"/><TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1"/>
          <TextBlock Grid.Row="2" Text="SSH-порт" VerticalAlignment="Center"/><TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="1"/>
          <TextBlock Grid.Row="3" Text="Логин" VerticalAlignment="Center"/><TextBox x:Name="UsernameBox" Grid.Row="3" Grid.Column="1"/>
          <TextBlock Grid.Row="4" Text="Пароль" VerticalAlignment="Center"/><local:SecretBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1"/>
          <TextBlock Grid.Row="5" Text="Root-логин" VerticalAlignment="Center"/><TextBox x:Name="RootLoginBox" Grid.Row="5" Grid.Column="1" ToolTip="Команда su/sudo из Autocommand или login script KiTTY, например su - или sudo su -"/>
          <TextBlock Grid.Row="6" Text="Root-пароль" VerticalAlignment="Center"/><local:SecretBox x:Name="RootPasswordBox" Grid.Row="6" Grid.Column="1" ToolTip="Пароль для команды su/sudo"/>
        </Grid></ScrollViewer>
      </TabItem>
      <TabItem Header="Расширенное">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
          <TextBlock Text="Приватный ключ"/><TextBox x:Name="PrivateKeyBox" ToolTip="Путь к PPK/PEM на этом ПК. Оставьте пустым, если ключ лежит на jumphost — пароль ключа всё равно будет передан."/>
          <TextBlock Text="Passphrase ключа" Margin="0,8,0,0"/><local:SecretBox x:Name="PrivateKeyPassphraseBox"/>
          <CheckBox x:Name="KeyboardInteractiveBox" Content="Keyboard-interactive" Margin="0,10,0,0"
                    Style="{StaticResource {x:Type CheckBox}}"
                    ToolTip="Разрешить интерактивную SSH-аутентификацию с вопросами сервера, например одноразовым кодом или дополнительным паролем."/>
          <CheckBox x:Name="TryDirectBox" Content="Сначала пробовать без jumphost"
                    Style="{StaticResource {x:Type CheckBox}}"
                    ToolTip="Сначала попробовать SSH напрямую с этого компьютера. Если прямой доступ не работает, менеджер использует обычные сохранённые связи и точки входа; после обходного подключения прямой путь перепроверяется в фоне."/>
          <CheckBox x:Name="IgnoreCommandBox" Content="Не выполнять импортированную команду"
                    Style="{StaticResource {x:Type CheckBox}}"/>
          <TextBlock Text="Ожидаемая строка shell" Margin="0,8,0,0"/><TextBox x:Name="ShellPromptBox" ToolTip="Часть приглашения shell, после которой можно безопасно отправить su/sudo. Обычно $"/>
          <TextBlock Text="Импортированная команда" Margin="0,8,0,0"/><TextBox x:Name="ImportedCommandBox" AcceptsReturn="True" Height="70" ToolTip="Команда Autocommand из исходной сессии KiTTY. Изменение действует только внутри менеджера."/>
          <TextBlock Text="Обязательный предыдущий сервер" Margin="0,8,0,0"/>
          <ComboBox x:Name="RequiredPreviousBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                    ToolTip="Если выбрана сессия, она всегда будет последним SSH-переходом перед этой целью. Используйте для одинаковых private IP в разных сетях."/>
          <TextBlock Text="Резервные адреса" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <DataGrid x:Name="BackupGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="150">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Host" Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="*" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"/>
              <DataGridTextColumn Header="Порт" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="100" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"/>
              <DataGridCheckBoxColumn Header="Внутренняя подсеть" Binding="{Binding InternalOnly, UpdateSourceTrigger=PropertyChanged}" Width="160"
                                      ElementStyle="{StaticResource DataGridCheckBoxStyle}"
                                      EditingElementStyle="{StaticResource DataGridCheckBoxStyle}"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Добавить" Style="{StaticResource SuccessButton}" Click="AddBackup_Click" Margin="0,0,8,0"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="RemoveBackup_Click"/>
          </WrapPanel>
          <TextBlock Text="Веб-интерфейсы" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <DataGrid x:Name="WebGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="150">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Название" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="140" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"/>
              <DataGridTextColumn Header="URL" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="*" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"/>
              <DataGridTextColumn Header="Логин" Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="120" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"/>
              <DataGridTextColumn Header="Пароль" Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Width="120" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"/>
              <DataGridTextColumn Binding="{Binding ResolverAddress, UpdateSourceTrigger=PropertyChanged}" Width="140" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}">
                <DataGridTextColumn.Header>
                  <TextBlock Text="Адрес DNS" ToolTip="Если указан IP, менеджер сам разрешает домен через веб-туннель. Если поле пустое, используется системное разрешение DNS и файл hosts."/>
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Добавить" Style="{StaticResource SuccessButton}" Click="AddWeb_Click" Margin="0,0,8,0"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="RemoveWeb_Click"/>
          </WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Связи">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <CheckBox x:Name="BuildLinksBox" Content="Сразу построить связь с выбранными серверами"
                    Style="{StaticResource {x:Type CheckBox}}" Checked="BuildLinksBox_Changed" Unchecked="BuildLinksBox_Changed"/>
          <local:ServerSelectionList x:Name="LinkServerSelector" Grid.Row="1" Margin="0,10,0,0"/>
        </Grid>
      </TabItem>
      <TabItem Header="Группа">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBox x:Name="GroupSearchBox" TextChanged="GroupSearchBox_TextChanged"
                   ToolTip="Поиск по названию или пути группы"/>
          <WrapPanel Grid.Row="1" Margin="0,8,0,8">
            <Button x:Name="UngroupedButton" Content="Без группы" Click="UngroupedButton_Click" Margin="0,0,8,0"
                    ToolTip="Поместить сессию на верхний уровень без привязки к группе"/>
            <Button x:Name="CreateGroupButton" Content="Создать группу" Click="CreateGroup_Click" Margin="0,0,8,0"
                    ToolTip="Создать новую корневую группу"/>
            <Button x:Name="CreateSubgroupButton" Content="Создать подгруппу" Click="CreateSubgroup_Click" Margin="0,0,8,0"
                    ToolTip="Создать подгруппу внутри выбранной группы"/>
            <TextBlock x:Name="SelectedGroupText" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
          </WrapPanel>
          <Grid Grid.Row="2">
            <ListBox x:Name="GroupList" MinHeight="140" SelectionMode="Single"
                     SelectionChanged="GroupList_SelectionChanged"
                     local:ScrollWheelForwarding.Enabled="True">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="4,3"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="{Binding Indent}">
                    <StackPanel Margin="6,3,0,3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                 Foreground="{Binding Foreground}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Details}" Margin="0,2,0,0" FontSize="12"
                                 Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyGroupText" Text="Ничего не найдено"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Отмена" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Сохранить" IsDefault="True" Margin="8,0,0,0" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
