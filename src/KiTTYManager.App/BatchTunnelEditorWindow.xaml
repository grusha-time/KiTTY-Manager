<Window x:Class="KiTTYManager.App.BatchTunnelEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Туннель массовой задачи" Width="660" Height="650" MinWidth="560" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Настройка SSH-туннеля" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="KindHelp" TextWrapping="Wrap" Opacity="0.8" Margin="0,5,0,12"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Название" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" Margin="0,4,0,8"/>
      <TextBlock Grid.Row="1" Text="Тип" VerticalAlignment="Center"/><ComboBox x:Name="KindBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,8" SelectionChanged="KindBox_SelectionChanged"><ComboBoxItem Content="Local — порт на моём ПК" Tag="Local"/><ComboBoxItem Content="Remote — порт на сервере" Tag="Remote"/></ComboBox>
      <TextBlock x:Name="BindHostLabel" Grid.Row="2" Text="Где открыть порт" VerticalAlignment="Center"/><TextBox x:Name="BindHostBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,8"/>
      <TextBlock x:Name="BindPortLabel" Grid.Row="3" Text="Какой порт открыть" VerticalAlignment="Center"/><TextBox x:Name="BindPortBox" Grid.Row="3" Grid.Column="1" Margin="0,4,0,8"/>
      <TextBlock x:Name="DestinationHostLabel" Grid.Row="4" Text="Куда вести трафик (адрес)" VerticalAlignment="Center"/><TextBox x:Name="DestinationHostBox" Grid.Row="4" Grid.Column="1" Margin="0,4,0,8"/>
      <TextBlock x:Name="DestinationPortLabel" Grid.Row="5" Text="Куда вести трафик (порт)" VerticalAlignment="Center"/><TextBox x:Name="DestinationPortBox" Grid.Row="5" Grid.Column="1" Margin="0,4,0,8"/>
      <TextBlock x:Name="FieldsHelp" Grid.Row="6" Grid.ColumnSpan="2" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
      <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,10,0,0"><TextBlock Text="На каких из ранее выбранных серверов создать туннель" FontWeight="SemiBold"/><TextBlock Text="Для всех — оставьте первую галочку. Для части — снимите её, найдите сервер и нажмите на строку." Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,6"/><CheckBox x:Name="AllServersBox" Content="На всех серверах, выбранных на шаге 1" Margin="0,4,0,5" Checked="AllServersBox_Changed" Unchecked="AllServersBox_Changed"/><TextBox x:Name="ServerSearchBox" ToolTip="Поиск по выбранным серверам" Margin="0,2,0,5" TextChanged="ServerSearchBox_TextChanged"/><ListBox x:Name="ServersList" MinHeight="150" PreviewMouseLeftButtonUp="ServersList_MouseLeftButtonUp"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding Selected}" IsHitTestVisible="False" Margin="4"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
    </Grid></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button IsCancel="True">Отмена</Button><Button IsDefault="True" Click="Done_Click">Готово</Button></StackPanel>
  </Grid>
</Window>
