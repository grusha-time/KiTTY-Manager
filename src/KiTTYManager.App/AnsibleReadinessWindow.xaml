<Window x:Class="KiTTYManager.App.AnsibleReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Готовность Ansible" Width="820" Height="560" MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Проверка готовности Ansible" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Рекомендуется запуск KiTTY Manager от имени системного администратора"
                       Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7"/>
            <TextBlock x:Name="SummaryText" Text="Выполняются системные проверки…" Margin="0,6,0,14" Opacity="0.75"/>
        </StackPanel>
        <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Проверка" Binding="{Binding Stage}" Width="210"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Message}" Width="*"/>
                <DataGridTextColumn Header="Как исправить" Binding="{Binding EnableCommand}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CopyButton" Content="Копировать результаты" Click="Copy_Click" IsEnabled="False"/>
            <Button Content="Закрыть" Click="Close_Click" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
