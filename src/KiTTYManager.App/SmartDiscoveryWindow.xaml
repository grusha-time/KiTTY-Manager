<Window x:Class="KiTTYManager.App.SmartDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KiTTYManager.App"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}"
        Title="Умное массовое добавление сессий"
        Width="1050" Height="740" MinWidth="850" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style x:Key="DiscoveryCheckBoxStyle" TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border Background="Transparent" SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="Box" Width="15" Height="15" Background="#1B1B1B" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path x:Name="Check" Data="M 3,7 L 6,10 L 12,3" Stroke="White" StrokeThickness="2"
                      Width="10" Height="8" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                <Border x:Name="Indeterminate" Width="8" Height="2" Background="White"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="Indeterminate" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DiscoveryCheckBoxCellStyle" TargetType="DataGridCell"
           BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="DiscoveryEditableCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Setter Property="ToolTip" Value="Двойной клик — редактировать"/>
    </Style>
    <Style x:Key="DiscoveryReadOnlyCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Setter Property="ToolTip" Value="Двойной клик — открыть сессию без сохранения"/>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Input and Parameters Area -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.8*"/>
          </Grid.ColumnDefinitions>

          <!-- Target Hosts -->
          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Список IP-адресов / хостов:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="HostsInputBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"
                     ToolTip="Введите IP-адреса через пробел, запятую, точку с запятой или с новой строки"/>
          </StackPanel>

          <!-- Logins -->
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="Логины (по одному на строку):" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginsInputBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"
                     ToolTip="Список учётных записей для SSH-входа"/>
          </StackPanel>

          <!-- Passwords -->
          <StackPanel Grid.Column="2">
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Пароли (SSH и Root):" FontWeight="SemiBold"/>
              <Button Grid.Column="1" x:Name="TogglePasswordsMaskButton" Content="👁 Скрыть/Показать"
                      Click="TogglePasswordsMask_Click" Padding="6,2" MinHeight="22" FontSize="11"/>
            </Grid>
            <TextBox x:Name="PasswordsInputBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"
                     ToolTip="Список паролей учетных записей и root-паролей для su/sudo"/>
          </StackPanel>
        </Grid>

        <!-- Options row -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="70"/>
          </Grid.ColumnDefinitions>

          <TextBlock Text="Точка входа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="JumpHostComboBox" Grid.Column="1" Margin="0,0,12,0"/>

          <TextBlock Grid.Column="2" Text="Целевая группа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Grid Grid.Column="3" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetGroupBox" IsReadOnly="True" Cursor="Hand"
                     PreviewMouseLeftButtonDown="TargetGroupBox_PreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="TargetGroupBox_PreviewMouseLeftButtonUp"
                     PreviewKeyDown="TargetGroupBox_PreviewKeyDown"
                     ToolTip="Целевая группа для создаваемых сессий"/>
            <Popup x:Name="GroupPickerPopup" PlacementTarget="{Binding ElementName=TargetGroupBox}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
              <Border Width="380" MaxHeight="470" Margin="0,6,0,0" Padding="12"
                      Background="#1C1C1C" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBox x:Name="GroupSearchBox" TextChanged="GroupSearchBox_TextChanged"
                           PreviewKeyDown="GroupSearchBox_PreviewKeyDown"
                           ToolTip="Поиск по названию или пути группы"/>
                  <Grid Grid.Row="1" Margin="0,8,0,0">
                    <ListBox x:Name="GroupChoicesList" MinHeight="140" MaxHeight="320"
                             PreviewMouseLeftButtonDown="GroupChoicesList_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="GroupChoicesList_PreviewKeyDown"
                             local:ScrollWheelForwarding.Enabled="True">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                          <Setter Property="Padding" Value="4,2"/>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="{Binding Indent}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Details}" Margin="0,2,0,0" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoGroupChoicesText" Text="Ничего не найдено"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
                  </Grid>
                </Grid>
              </Border>
            </Popup>
          </Grid>

          <TextBlock Grid.Column="4" Text="Подгруппа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="TargetSubgroupBox" Grid.Column="5" Margin="0,0,12,0" ToolTip="Название подгруппы (необязательно)"/>

          <TextBlock Grid.Column="6" Text="Потоки:" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="ParallelismComboBox" Grid.Column="7" SelectedIndex="3">
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="8"/>
            <ComboBoxItem Content="16"/>
          </ComboBox>
        </Grid>

        <!-- Secondary options row -->
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <CheckBox x:Name="PreferGroupGatewaysCheckBox" Grid.Column="0"
                    Content="Сначала через независимые серверы группы"
                    IsChecked="True" VerticalAlignment="Center" Margin="0,0,24,0"
                    ToolTip="При указании целевой группы сначала пробовать подключение через её независимые серверы-шлюзы"/>

          <TextBlock Grid.Column="1" Text="Стартовая сессия:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="InitialGatewaySessionComboBox" Grid.Column="2"
                    ToolTip="Сессия, которая будет опробована в качестве первого шлюза с наивысшим приоритетом"/>
        </Grid>

        <!-- Scan action buttons -->
        <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
          <Button x:Name="StartScanButton" Content="Начать сканирование" Tag="Primary" Click="StartScan_Click" Margin="0,0,8,0"/>
          <Button x:Name="StopScanButton" Content="Остановить" Tag="Danger" Click="StopScan_Click" IsEnabled="False" Margin="0,0,8,0"/>
          <Button x:Name="RetrySelectedButton" Content="Повторить выбранные" Click="RetrySelected_Click" IsEnabled="False"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Progress and Status Row -->
    <Grid Grid.Row="1" Margin="0,10,0,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ProgressBar x:Name="ScanProgressBar" Height="6" Maximum="100" Value="0" Margin="0,0,0,4"/>
      <TextBlock Grid.Row="1" x:Name="StatusTextBlock" Text="Готов к сканированию" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
    </Grid>

    <!-- Results Tabs -->
    <TabControl x:Name="ResultsTabControl" Grid.Row="2">
      <!-- Tab 1: Successful Candidates -->
      <TabItem Header="Успешные подключения">
        <Grid Margin="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Candidates Toolbar -->
          <WrapPanel Margin="0,0,0,8">
            <Button Content="Выбрать все" Click="SelectAllCandidates_Click" Margin="0,0,8,0"/>
            <Button Content="Снять выбор" Click="DeselectAllCandidates_Click" Margin="0,0,8,0"/>
            <Button Content="Массово изменить группу/подгруппу" Click="BulkChangeGroup_Click"/>
          </WrapPanel>

          <!-- Candidates DataGrid -->
          <DataGrid x:Name="CandidatesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                    CanUserDeleteRows="False" SelectionMode="Single"
                    MouseDoubleClick="CandidatesGrid_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Создать" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="65"
                                      ElementStyle="{StaticResource DiscoveryCheckBoxStyle}"
                                      EditingElementStyle="{StaticResource DiscoveryCheckBoxStyle}"
                                      CellStyle="{StaticResource DiscoveryCheckBoxCellStyle}"/>
              <DataGridTextColumn Header="IP / Хост" Binding="{Binding Host}" IsReadOnly="True" Width="Auto" MinWidth="120"
                                  CellStyle="{StaticResource DiscoveryReadOnlyCellStyle}"/>
              <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" IsReadOnly="True" Width="Auto" MinWidth="120"
                                  CellStyle="{StaticResource DiscoveryReadOnlyCellStyle}"/>
              <DataGridTextColumn Header="Название сессии" Binding="{Binding ProposedName, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="170"
                                  EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"
                                  CellStyle="{StaticResource DiscoveryEditableCellStyle}"/>
              <DataGridTextColumn Header="Группа" Binding="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="110"
                                  EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"
                                  CellStyle="{StaticResource DiscoveryEditableCellStyle}"/>
              <DataGridTextColumn Header="Подгруппа" Binding="{Binding SubgroupName, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="90"
                                  EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"
                                  CellStyle="{StaticResource DiscoveryEditableCellStyle}"/>
              <DataGridTextColumn Header="Логин" Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="80"
                                  EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"
                                  CellStyle="{StaticResource DiscoveryEditableCellStyle}"/>

              <!-- Masked / Clear Password with Toggle & Copy -->
              <DataGridTemplateColumn Header="Пароль" Width="Auto" MinWidth="150" CellStyle="{StaticResource DiscoveryReadOnlyCellStyle}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding DisplayPassword}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="1" Content="👁" Click="TogglePasswordVisibility_Click" Padding="4,1" MinHeight="22" Margin="4,0,0,0" ToolTip="Показать/скрыть"/>
                      <Button Grid.Column="2" Content="Коп." Click="CopyCandidatePassword_Click" Padding="4,1" MinHeight="22" Margin="4,0,0,0" ToolTip="Копировать пароль"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Masked / Clear Root Password with Toggle & Copy -->
              <DataGridTemplateColumn Header="Пароль Root" Width="Auto" MinWidth="150" CellStyle="{StaticResource DiscoveryReadOnlyCellStyle}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding DisplayRootPassword}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="1" Content="👁" Click="ToggleRootPasswordVisibility_Click" Padding="4,1" MinHeight="22" Margin="4,0,0,0" ToolTip="Показать/скрыть"/>
                      <Button Grid.Column="2" Content="Коп." Click="CopyCandidateRootPassword_Click" Padding="4,1" MinHeight="22" Margin="4,0,0,0" ToolTip="Копировать пароль root"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="Повышение прав" Binding="{Binding PrivilegeEscalation.StatusDescription}" IsReadOnly="True" Width="Auto" MinWidth="160"
                                  CellStyle="{StaticResource DiscoveryReadOnlyCellStyle}"/>

              <!-- Links button -->
              <DataGridTemplateColumn Header="Связи" Width="75">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Связи" Click="CandidateLinks_Click" Padding="6,2" MinHeight="24"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="Статус" Binding="{Binding StatusMessage}" IsReadOnly="True" Width="Auto" MinWidth="220"
                                  CellStyle="{StaticResource DiscoveryReadOnlyCellStyle}"/>
            </DataGrid.Columns>
            <DataGrid.GroupStyle>
              <GroupStyle>
                <GroupStyle.Panel>
                  <ItemsPanelTemplate>
                    <primitives:DataGridRowsPresenter/>
                  </ItemsPanelTemplate>
                </GroupStyle.Panel>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="{x:Type GroupItem}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                          <StackPanel>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="4,6,0,4">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                      <Setter Property="Text" Value="Новые"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="True">
                                          <Setter Property="Text" Value="Дубли"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" Margin="6,0,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                              </StackPanel>
                            </Border>
                            <ItemsPresenter/>
                          </StackPanel>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </DataGrid.GroupStyle>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Tab 2: Problematic Hosts -->
      <TabItem Header="Проблемные подключения">
        <Grid Margin="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <WrapPanel Margin="0,0,0,8">
            <Button Content="Выбрать все" Click="SelectAllProblems_Click" Margin="0,0,8,0"/>
            <Button Content="Снять выбор" Click="DeselectAllProblems_Click" Margin="0,0,8,0"/>
            <Button Content="Повторить проверку выбранных" Tag="Primary" Click="RetrySelected_Click"/>
          </WrapPanel>

          <DataGrid x:Name="ProblemsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                    CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                      ElementStyle="{StaticResource DiscoveryCheckBoxStyle}"
                                      EditingElementStyle="{StaticResource DiscoveryCheckBoxStyle}"
                                      CellStyle="{StaticResource DiscoveryCheckBoxCellStyle}"/>
              <DataGridTextColumn Header="IP / Хост" Binding="{Binding Host}" IsReadOnly="True" Width="150"/>
              <DataGridTextColumn Header="Этап проверки" Binding="{Binding Stage}" IsReadOnly="True" Width="150"/>
              <DataGridTextColumn Header="Причина ошибки" Binding="{Binding Reason}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Bottom Bar -->
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="SummaryCountsTextBlock" Text="Найдено сессий: 0 | Проблемных: 0"
                 VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"/>

      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <CheckBox x:Name="LinkExistingIndependentServersCheckBox" IsChecked="True"
                  Content="Построить связь с существующими независимыми серверами группы"
                  VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="CreateSessionsButton" Content="Создать сессии" Tag="Success" IsDefault="True"
                Click="CreateSessions_Click" Margin="0,0,8,0" Padding="20,8"/>
        <Button Content="Закрыть" IsCancel="True" Click="Close_Click"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
