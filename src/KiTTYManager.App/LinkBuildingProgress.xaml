<Window x:Class="KiTTYManager.App.LinkBuildingProgress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Построение связей" Width="440" SizeToContent="Height" MinHeight="150"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        ResizeMode="NoResize" Background="{StaticResource WindowBrush}" Closing="Window_Closing"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="StatusText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <ProgressBar x:Name="Progress" Grid.Row="1" Height="22" Minimum="0" Maximum="100" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Отменить" Click="Cancel_Click" Padding="16,6" Margin="0,0,8,0"/>
      <Button Content="Свернуть" Click="Hide_Click" Padding="16,6" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
