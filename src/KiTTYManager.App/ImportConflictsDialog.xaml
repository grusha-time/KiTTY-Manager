<Window x:Class="KiTTYManager.App.ImportConflictsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Конфликты импорта" Width="1080" Height="680"
        MinWidth="820" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Разрешите конфликты" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                 Text="Новые объекты будут добавлены. Для совпавших выберите данные из импортируемого файла или сохраните текущие."/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,12">
      <Button Content="Использовать новые для всех" Click="AllIncoming_Click" Margin="0,0,8,0"/>
      <Button Content="Сохранить текущие для всех" Click="AllCurrent_Click"/>
    </StackPanel>

    <DataGrid x:Name="ConflictsGrid" Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Новые данные" Binding="{Binding UseIncoming, UpdateSourceTrigger=PropertyChanged}" Width="112"/>
        <DataGridTextColumn Header="Тип" Binding="{Binding KindText}" Width="120" IsReadOnly="True"/>
        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
        <DataGridTextColumn Header="Сейчас" Binding="{Binding CurrentSummary}" Width="2*" IsReadOnly="True"/>
        <DataGridTextColumn Header="Из файла" Binding="{Binding IncomingSummary}" Width="2*" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="3" Margin="0,18,0,0">
      <TextBlock Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                 Text="Отмечено — использовать новые данные."/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
        <Button Content="Импортировать" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Import_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
