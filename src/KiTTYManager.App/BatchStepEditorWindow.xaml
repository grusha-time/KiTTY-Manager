<Window x:Class="KiTTYManager.App.BatchStepEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Действие массовой задачи" Width="700" Height="720" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Добавление действия" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="1. Выберите тип. 2. Заполните показанные поля. 3. Нажмите «Готово»." Margin="0,5,0,14" Opacity="0.75" TextWrapping="Wrap"/>
      <TextBlock Text="Тип действия"/>
      <ComboBox x:Name="KindBox" Margin="0,5,0,8" SelectionChanged="KindBox_SelectionChanged"/>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
        <TextBlock x:Name="KindHelp" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="Понятное название шага"/>
      <TextBox x:Name="NameBox" Margin="0,5,0,12"/>
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel x:Name="CommandPanel">
          <TextBlock Text="Команда на сервере"/>
          <TextBox x:Name="CommandBox" Margin="0,5,0,4" AcceptsReturn="True" MinHeight="70"/>
          <TextBlock Text="Выполняется через SSH без открытия окна KiTTY с ожиданием завершения команды и записью вывода в журнал. Каждая строка — отдельная команда, выполняются по очереди." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <TextBlock Text="Папка для этой команды (необязательно)"/>
          <TextBox x:Name="StepWorkingDirectoryBox" Margin="0,5,0,12" ToolTip="Если оставить пустым — используется рабочая папка всей задачи. Например /opt/app: команда сначала перейдёт туда."/>
        </StackPanel>
        <StackPanel x:Name="DialogPanel">
          <TextBlock Text="Команда запуска программы в консоли (необязательно)"/>
          <TextBox x:Name="DialogCommandBox" Margin="0,5,0,4" ToolTip="Например: mysql или python3 installer.py. Если оставить пустым — используется консоль, открытая предыдущим действием диалога."/>
          <TextBlock Text="Папка для этой команды (необязательно)" Margin="0,5,0,0"/>
          <TextBox x:Name="DialogWorkingDirectoryBox" Margin="0,5,0,4" ToolTip="Если оставить пустым — используется рабочая папка всей задачи. Например /opt/app: команда сначала перейдёт туда."/>
          <TextBlock Text="Блоки «дождаться текста → ответить». Выполняются по очереди в одной консоли." Margin="0,8,0,4" FontWeight="SemiBold"/>
          <ItemsControl x:Name="BlocksList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Text="Ждать текст" Opacity="0.7"/>
                      <TextBox Text="{Binding WaitText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                      <TextBlock Text="Ответить" Opacity="0.7"/>
                      <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Удалить" VerticalAlignment="Bottom" Click="RemoveBlock_Click" Tag="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="+ Добавить блок" HorizontalAlignment="Left" Click="AddBlock_Click" Margin="0,2,0,12"/>
          <TextBlock Text="Максимальное ожидание каждого блока, секунд"/>
          <TextBox x:Name="TimeoutBox" Margin="0,5,0,12" Width="100" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel x:Name="ExpectedPanel"><TextBlock Text="Какой текст ждать"/><TextBox x:Name="ExpectedBox" Margin="0,5,0,4"/><TextBlock Text="Совпадение точное, с учётом регистра. Check проверяет вывод завершённой команды; ожидание текста работает с потоком общей SSH-консоли." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
        <StackPanel x:Name="ActionPanel"><TextBlock Text="Что выполнить после найденного текста"/><TextBox x:Name="ActionBox" Margin="0,5,0,12" AcceptsReturn="True" MinHeight="55"/></StackPanel>
        <StackPanel x:Name="SourcePanel">
          <TextBlock Text="Файлы с вашего ПК"/>
          <Grid Margin="0,5,0,4" ToolTip="Выберите один или несколько файлов для загрузки. Старые задачи с ранее добавленными папками продолжают работать. Пути сохраняются в задаче; при включении упаковки файлов их содержимое добавляется в .kmtask.">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListBox x:Name="SourceFilesList" Height="112" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
              <Button x:Name="PickSourceButton" Content="Добавить файлы…" Click="PickSource_Click"/>
              <Button Content="Убрать выбранный" Margin="0,8,0,0" Click="RemoveSource_Click"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Путь на сервере (файл или папка)"/>
          <TextBox x:Name="DestinationBox" Margin="0,5,0,6" ToolTip="Куда положить на сервере. Если указать существующий каталог — файлы будут положены внутрь него."/>
        </StackPanel>
        <StackPanel x:Name="DownloadPanel">
          <TextBlock Text="Что скачать с сервера (по одному пути в строке)"/>
          <TextBox x:Name="RemotePathsBox" Margin="0,5,0,6" AcceptsReturn="True" MinHeight="70" ToolTip="Точные пути или маски. Примеры:&#x0a;/var/log/app/app.log — один файл&#x0a;/var/log/nginx/ — вся папка&#x0a;/var/log/app/*.log — все файлы по маске&#x0a;&#x0a;Маски: * (любые символы), ? (один символ), [abc] (один из перечисленных)."/>
          <TextBlock Text="Название папки для этого действия (необязательно)"/>
          <TextBox x:Name="DownloadFolderBox" Margin="0,5,0,6" ToolTip="Если заполнить — файлы сохранятся в Downloads/«сессия адрес»/«эта папка». Если оставить пустым — в Downloads/«сессия адрес»."/>
          <CheckBox x:Name="DownloadAsArchiveBox" Content="Скачать в виде архива" Margin="0,4,0,4"/>
          <TextBlock Text="Ускоряет скачивание по медленному соединению. Менеджер автоматически выбирает доступный tar/gzip/zip и максимальное сжатие. Временный архив создаётся на сервере рядом с выбранными файлами или папками и удаляется после успеха, ошибки или остановки задачи." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="Файлы сохраняются рядом с менеджером в папку Downloads, в подпапку с названием сессии и адресом сервера. При включённой архивации на ПК сохраняется сам архив." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel>
        <StackPanel x:Name="DestOnlyPanel">
          <TextBlock Text="Путь на сервере (файл или папка)"/>
          <TextBox x:Name="DestOnlyBox" Margin="0,5,0,12"/>
        </StackPanel>
        <StackPanel x:Name="DeletePanel">
          <TextBlock Text="Что удалить на сервере (путь или маска)"/>
          <TextBox x:Name="DeletePathBox" Margin="0,5,0,6" ToolTip="Точный путь или маска. Примеры:&#x0a;/tmp/old-build&#x0a;/var/log/app/*.log"/>
          <TextBlock Text="Удаление необратимо. Маска * раскрывается оболочкой сервера." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel>
        <StackPanel x:Name="ReplacePanel"><TextBlock Text="Искомый текст"/><TextBox x:Name="SearchBox" Margin="0,5,0,10"/><TextBlock Text="Замена"/><TextBox x:Name="ReplacementBox" Margin="0,5,0,12"/></StackPanel>
        <StackPanel x:Name="ServersPanel" Margin="0,0,0,12">
          <TextBlock Text="На каких серверах выполнить это действие" FontWeight="SemiBold"/>
          <TextBlock Text="По умолчанию действие выполняется на всех серверах, выбранных на шаге 1. Чтобы выполнить только на части — снимите галочку и отметьте нужные серверы. Так можно выстроить очередь: сначала обновить одни серверы, следующими действиями — другие." Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,6"/>
          <CheckBox x:Name="AllServersBox" Content="На всех серверах задачи" Margin="0,2,0,5" Checked="AllServersBox_Changed" Unchecked="AllServersBox_Changed"/>
          <TextBox x:Name="ServerSearchBox" ToolTip="Поиск по серверам" Margin="0,2,0,5" TextChanged="ServerSearchBox_TextChanged"/>
          <ListBox x:Name="ServersList" MinHeight="120" MaxHeight="180" PreviewMouseLeftButtonUp="ServersList_MouseLeftButtonUp">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding Selected}" IsHitTestVisible="False" Margin="4"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <TextBlock Text="Дополнительное условие (необязательно): выполнить шаг, только если команда завершилась с кодом 0" TextWrapping="Wrap"/>
        <TextBox x:Name="ConditionBox" Margin="0,5,0,4" ToolTip="Например: test -f /opt/app/flag. Результат проверки запоминается для этого сервера и не выполняется повторно в следующих действиях с тем же условием."/>
        <TextBlock Text="Одинаковое условие в нескольких действиях работает как «Если … то»: проверится один раз, и все действия с этим условием выполнятся (или все пропустятся)." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Margin="0,0,0,8">
          <TextBlock Text="Выполнить под учётной записью (необязательно)" FontWeight="SemiBold"/>
          <TextBlock Text="Поддерживается для команд, проверок, создания/удаления каталогов и интерактивного запуска. Для Upload, Download, Template, ReplaceText и прямой отправки текста используйте команду или Ansible. Пусто = текущая учётная запись сессии." Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,4"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="Логин" Opacity="0.7"/><TextBox x:Name="RunAsUserBox" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Пароль (если нужен для su)" Opacity="0.7"/><PasswordBox x:Name="RunAsPasswordBox" Margin="0,3,0,0"/></StackPanel>
          </Grid>
        </StackPanel>
        <CheckBox x:Name="BackupBox" Content="Сделать backup изменяемого файла" Margin="0,0,0,8"/>
        <CheckBox x:Name="ContinueOnErrorBox" Content="Не останавливать сервер, если это действие завершилось с ошибкой" ToolTip="По умолчанию ошибка действия останавливает дальнейшие действия на этом сервере. Включите, если действие необязательное (например, удаление старых логов)."/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="Пауза после завершения, секунд:" VerticalAlignment="Center"/>
          <TextBox x:Name="WaitAfterBox" Width="60" Margin="8,0,0,0" ToolTip="Задержка перед следующим действием. Полезно после перезапуска сервиса, чтобы он успел подняться. 0 = без паузы."/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Click="Cancel_Click">Отмена</Button><Button IsDefault="True" Click="Done_Click">Готово</Button>
    </StackPanel>
  </Grid>
</Window>
