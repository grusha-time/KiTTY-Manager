<Window x:Class="KiTTYManager.App.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Обновление KiTTY Manager"
        Width="680" Height="540" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/kitty-manager.ico"
        FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Обновление KiTTY Manager" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="Проверка новых релизов и безопасное обновление программы" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0"/>
    </StackPanel>

    <!-- Version status panel -->
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Установленная версия:" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
          <TextBlock x:Name="CurrentVersionText" Text="2.1.0" FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Доступный релиз:" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
          <TextBlock x:Name="AvailableVersionText" Text="Проверка ещё не выполнялась" FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Changelog section -->
    <DockPanel Grid.Row="2" Margin="0,0,0,14">
      <TextBlock DockPanel.Dock="Top" Text="Список изменений:" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="6">
        <TextBox x:Name="ChangelogBox" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" Foreground="{StaticResource TextBrush}"
                 BorderThickness="0" Padding="8" FontFamily="Segoe UI" FontSize="13"/>
      </Border>
    </DockPanel>

    <!-- Status & Progress -->
    <StackPanel Grid.Row="3" Margin="0,0,0,16">
      <ProgressBar x:Name="UpdateProgressBar" Height="6" Visibility="Collapsed" Margin="0,0,0,6"/>
      <TextBlock x:Name="StatusTextBlock" Text="" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Buttons -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="CheckButton" Grid.Column="0" Content="Проверить наличие обновлений" Click="CheckButton_Click"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="InstallButton" Content="Установить обновление" Tag="Primary"
                Click="InstallButton_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
        <Button x:Name="CloseButton" Content="Закрыть" IsCancel="True" Click="CloseButton_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
