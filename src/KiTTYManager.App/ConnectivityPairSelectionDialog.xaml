<Window x:Class="KiTTYManager.App.ConnectivityPairSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KiTTYManager.App"
        Style="{StaticResource {x:Type Window}}"
        Title="Направления построения связей" Width="980" Height="720"
        MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Выберите серверы, затем снимите ненужные направленные пары. Исключения действуют только для этого запуска."
                 Margin="0,5,0,12" Opacity="0.75" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="Группы и серверы">
        <local:ServerSelectionList x:Name="ServerSelector" Margin="8"/>
      </GroupBox>
      <GroupBox Grid.Column="2" Header="Планируемые направления"><Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel><Button Click="SelectAll_Click">Выбрать все</Button><Button Click="ClearAll_Click">Снять все</Button><TextBlock x:Name="CountText" Margin="12,0,0,0" VerticalAlignment="Center"/></WrapPanel>
        <DataGrid x:Name="PairsGrid" Grid.Row="1" Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Проверить" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                    ElementStyle="{StaticResource DataGridCheckBoxStyle}"
                                    EditingElementStyle="{StaticResource DataGridCheckBoxStyle}"/>
            <DataGridTextColumn Header="Направление" Binding="{Binding Display}" Width="*" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></GroupBox>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Отмена" IsCancel="True"/><Button Content="Начать" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Start_Click"/>
    </StackPanel>
  </Grid>
</Window>
