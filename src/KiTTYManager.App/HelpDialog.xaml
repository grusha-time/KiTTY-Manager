<Window x:Class="KiTTYManager.App.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Справка по KiTTY Manager"
        Width="980" Height="760" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Справка" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Обезличенное описание полей, настроек и действий" Foreground="{StaticResource MutedTextBrush}"/>
    </StackPanel>
    <TabControl Grid.Row="1" Background="#171717">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
          <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
          <Setter Property="Padding" Value="12,7"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="#333333" BorderThickness="1,1,1,0">
                  <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource SurfaceSelectedBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#303030"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem Header="Сессии"><TextBox x:Name="SessionsText" Style="{x:Null}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="18" Background="#171717" Foreground="#F2F2F2" CaretBrush="#F2F2F2" BorderThickness="0"/></TabItem>
      <TabItem Header="Точки входа"><TextBox x:Name="ProxiesText" Style="{x:Null}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="18" Background="#171717" Foreground="#F2F2F2" CaretBrush="#F2F2F2" BorderThickness="0"/></TabItem>
      <TabItem Header="Настройки и данные"><TextBox x:Name="SettingsText" Style="{x:Null}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="18" Background="#171717" Foreground="#F2F2F2" CaretBrush="#F2F2F2" BorderThickness="0"/></TabItem>
      <TabItem Header="Подключение и безопасность"><TextBox x:Name="SecurityText" Style="{x:Null}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="18" Background="#171717" Foreground="#F2F2F2" CaretBrush="#F2F2F2" BorderThickness="0"/></TabItem>
    </TabControl>
    <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True">Закрыть</Button>
  </Grid>
</Window>
