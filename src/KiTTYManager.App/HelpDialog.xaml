<Window x:Class="KiTTYManager.App.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Справка по полям"
        Width="1080" Height="800" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
  </Window.InputBindings>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Справка по полям" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Что означает настройка, когда её использовать и как проверить результат"
                 TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Поиск по всем разделам" Margin="0,0,0,6"/>
        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" MinHeight="36"
                 AutomationProperties.Name="Поиск по всем разделам справки"
                 ToolTip="Название поля или несколько слов: например Firefox профиль, SSH пароль, backup. Ctrl+F — перейти к поиску."/>
      </StackPanel>
      <Button Grid.Column="1" Content="Очистить" Click="ClearSearch_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="SectionsList" SelectionChanged="Section_Changed"
               AutomationProperties.Name="Разделы справки" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,7"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="ResultCount" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="EntriesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,12">
                  <StackPanel>
                    <TextBlock Text="{Binding Section}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Description, Mode=OneWay}" Style="{x:Null}" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0"
                             Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="14"
                             FontFamily="Segoe UI" HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{Binding Title}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap"
                   Text="Ничего не найдено. Попробуйте название поля, другое слово или очистите запрос."
                   Foreground="{DynamicResource MutedTextBrush}" Margin="18" VerticalAlignment="Top"/>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" IsCancel="True" Content="Закрыть"/>
      <TextBlock Text="Ctrl+F — поиск · Esc — очистить запрос или закрыть справку"
                 Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
    </DockPanel>
  </Grid>
</Window>
