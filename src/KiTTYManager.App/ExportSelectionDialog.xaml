<Window x:Class="KiTTYManager.App.ExportSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Экспорт конфигурации" Width="940" Height="680"
        MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Что экспортировать" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                 Text="Файл JSON содержит выбранные сессии, их веб-интерфейсы, пароли, группы и связи между выбранными сессиями."/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="Выбрать все" Click="SelectAll_Click" Margin="0,0,8,0"/>
          <Button Content="Снять выбор" Click="Clear_Click"/>
        </StackPanel>
        <CheckBox x:Name="EntryPointsCheckBox" Content="Добавить точки входа и настройки jumphost"
                  IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,12,0,0"
               TextChanged="SearchBox_TextChanged"
               ToolTip="Поиск по названию сессии, адресу, порту, группе и признаку jumphost"/>
    </Grid>

    <DataGrid x:Name="ServersGrid" Grid.Row="2" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Экспорт" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="86"/>
        <DataGridTextColumn Header="Сессия" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
        <DataGridTextColumn Header="Сервер" Binding="{Binding Endpoint}" Width="*" IsReadOnly="True"/>
        <DataGridTextColumn Header="Группа" Binding="{Binding GroupPath}" Width="2*" IsReadOnly="True"/>
        <DataGridCheckBoxColumn Header="Jumphost" Binding="{Binding IsJumphost}" Width="90" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="3" Margin="0,18,0,0">
      <TextBlock Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                 Text="Секреты сохраняются в открытом виде."/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
        <Button Content="Продолжить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Continue_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
