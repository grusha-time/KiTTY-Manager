<Window x:Class="KiTTYManager.App.SavedLinksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Сохранённые связи" Width="1280" Height="800" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
  <Grid Margin="24" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="MapViewport" Grid.Row="0" Background="#111318" ClipToBounds="True"
          PreviewMouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
          PreviewMouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
          PreviewMouseMove="MapViewport_MouseMove"
          PreviewMouseWheel="MapViewport_MouseWheel" MouseLeave="MapViewport_MouseLeave">
      <Canvas x:Name="GraphCanvas" RenderTransformOrigin="0,0">
        <Canvas.RenderTransform><TransformGroup>
          <ScaleTransform x:Name="GraphScale"/><TranslateTransform x:Name="GraphTranslate"/>
        </TransformGroup></Canvas.RenderTransform>
      </Canvas>
      <StackPanel x:Name="MapEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="Сохранённых связей пока нет" FontSize="20" FontWeight="SemiBold"/>
      </StackPanel>
      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,7"
              Background="#CC1A1A1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Перетаскивание — двигать · Колесо — масштаб   " Foreground="{StaticResource MutedTextBrush}"/>
          <Rectangle Width="22" Height="3" Fill="#4F8CFF" VerticalAlignment="Center"/>
          <TextBlock Text="  доступна   " Foreground="{StaticResource MutedTextBrush}"/>
          <Rectangle Width="22" Height="3" Fill="#D68A2E" VerticalAlignment="Center"/>
          <TextBlock Text="  нет подтверждения" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>
      </Border>
      <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
        <Button Click="ZoomOut_Click" Padding="10,5">−</Button>
        <TextBlock x:Name="ZoomText" Text="100%" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
        <Button Click="ZoomIn_Click" Padding="10,5">+</Button>
        <Button Click="Fit_Click" Padding="10,5" Margin="6,0,0,0">Вместить</Button>
      </WrapPanel>
    </Grid>

    <Border Grid.Row="1" Background="#1D1D1D" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8,8,0,0" Padding="1">
      <Grid Height="40" Margin="18,0,18,0" SizeChanged="LinksHeaderGrid_SizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="MarkColumn" Width="36"/>
          <ColumnDefinition x:Name="StatusColumn" Width="52"/>
          <ColumnDefinition x:Name="DirectionColumn" Width="0.8*" MinWidth="70"/>
          <ColumnDefinition x:Name="ServerColumn" Width="1.8*" MinWidth="120"/>
          <ColumnDefinition x:Name="GroupColumn" Width="1.8*" MinWidth="120"/>
          <ColumnDefinition x:Name="StrategyColumn" Width="1*" MinWidth="90"/>
          <ColumnDefinition x:Name="EntryColumn" Width="1.1*" MinWidth="100"/>
          <ColumnDefinition x:Name="LastSuccessColumn" Width="1.2*" MinWidth="120"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="Статус" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="Связь" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="Сервер" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4" Text="Группа" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="5" Text="Стратегия" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="6" Text="Точка входа" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="7" Text="Последний успех" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragCompleted="ColumnSplitter_DragCompleted"/>
        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragCompleted="ColumnSplitter_DragCompleted"/>
        <GridSplitter Grid.Column="4" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragCompleted="ColumnSplitter_DragCompleted"/>
        <GridSplitter Grid.Column="5" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragCompleted="ColumnSplitter_DragCompleted"/>
        <GridSplitter Grid.Column="6" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragCompleted="ColumnSplitter_DragCompleted"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBox x:Name="LinksSearchBox" Margin="8,8,8,4"
                 TextChanged="LinksSearchBox_TextChanged"
                 ToolTip="Поиск по серверу, адресу или группе"/>
        <TreeView x:Name="LinksTree" Grid.Row="1" Margin="8,4" HorizontalContentAlignment="Stretch"
                  PreviewMouseLeftButtonDown="LinksTree_PreviewMouseLeftButtonDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="3"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Cursor" Value="Hand"/>
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <Grid MinHeight="36" HorizontalAlignment="Stretch" ToolTip="{Binding StatusDetail}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding MarkWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                  <ColumnDefinition Width="{Binding StatusWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                  <ColumnDefinition Width="{Binding DirectionWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                  <ColumnDefinition Width="{Binding ServerWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                  <ColumnDefinition Width="{Binding GroupWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                  <ColumnDefinition Width="{Binding StrategyWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                  <ColumnDefinition Width="{Binding EntryWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                  <ColumnDefinition Width="{Binding LastSuccessWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsMarked}" IsThreeState="{Binding IsBranch}"
                          Checked="MarkCheckBox_Changed" Unchecked="MarkCheckBox_Changed" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusGlyph}" Foreground="{Binding StatusColor}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding StatusDetail}"/>
                <TextBlock Grid.Column="2" Text="{Binding DirectionDisplay}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}"/>
                <TextBlock x:Name="ItemName" Grid.Column="3" Text="{Binding DisplayName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="{Binding GroupPath}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="5" Text="{Binding Strategy}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="6" Text="{Binding ProxyName}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="7" Text="{Binding LastSuccessDisplay}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBranch}" Value="True">
                  <Setter TargetName="ItemName" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
              </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>

      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <WrapPanel>
        <Button Click="SelectAll_Click" Margin="0,0,8,0">Выбрать все</Button>
        <Button Click="ClearSelection_Click" Margin="0,0,8,0">Снять выбор</Button>
        <Button x:Name="DeleteSelectedButton" Click="DeleteSelected_Click" Margin="0,0,8,0">Удалить выбранные</Button>
        <Button x:Name="ConnectSelectedButton" Click="ConnectSelected_Click" Margin="0,0,8,0"
                Style="{StaticResource PrimaryButton}" IsEnabled="False">Подключиться через выбранную связь</Button>
        <Button x:Name="CheckAllButton" Click="CheckAll_Click" Style="{StaticResource PrimaryButton}"
                Margin="0,0,8,0" IsEnabled="False">Проверить выбранное</Button>
        <Button x:Name="CancelCheckButton" Click="CancelCheck_Click" Visibility="Collapsed">Остановить</Button>
      </WrapPanel>
      <TextBlock x:Name="StatusText" Grid.Column="1" Margin="18,0" Foreground="{StaticResource MutedTextBrush}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Button Grid.Column="2" Click="Close_Click" IsCancel="True">Закрыть</Button>
    </Grid>
  </Grid>
</Window>
