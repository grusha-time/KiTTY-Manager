<Window x:Class="KiTTYManager.App.SavedLinksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Сохранённые связи" Width="1180" Height="720" MinWidth="920" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
  <Grid Margin="24" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Сохранённые связи" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="DescriptionText" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#1D1D1D" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8,8,0,0" Padding="1">
      <Grid Height="40" Margin="18,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="52"/>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="270"/>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="155"/>
          <ColumnDefinition Width="170"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="Статус" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="Связь" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="Сервер" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4" Text="Группа" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="5" Text="Стратегия" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="6" Text="Последний успех" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="1">
      <Grid>
        <TreeView x:Name="LinksTree" Margin="8,4" HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="3"/>
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <Grid Width="1083" MinHeight="36" ToolTip="{Binding StatusDetail}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36"/>
                  <ColumnDefinition Width="52"/>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="270"/>
                  <ColumnDefinition Width="280"/>
                  <ColumnDefinition Width="155"/>
                  <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsMarked}" IsThreeState="{Binding IsBranch}"
                          Checked="MarkCheckBox_Changed" Unchecked="MarkCheckBox_Changed" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusGlyph}" Foreground="{Binding StatusColor}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding DirectionDisplay}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ItemName" Grid.Column="3" Text="{Binding DisplayName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="{Binding GroupPath}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="5" Text="{Binding Strategy}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="6" Text="{Binding LastSuccessDisplay}" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBranch}" Value="True">
                  <Setter TargetName="ItemName" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
              </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>

        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="Сохранённых связей пока нет" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                     TextAlignment="Center" MaxWidth="480"
                     Text="Проверенные связи выбранного сервера появятся здесь."/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <WrapPanel>
        <Button Click="SelectAll_Click" Margin="0,0,8,0">Выбрать все</Button>
        <Button Click="ClearSelection_Click" Margin="0,0,8,0">Снять выбор</Button>
        <Button x:Name="DeleteSelectedButton" Click="DeleteSelected_Click" Margin="0,0,8,0">Удалить выбранные</Button>
        <Button x:Name="ConnectSelectedButton" Click="ConnectSelected_Click" Margin="0,0,8,0"
                Style="{StaticResource PrimaryButton}" IsEnabled="False">Подключиться через выбранную связь</Button>
        <Button x:Name="CheckAllButton" Click="CheckAll_Click" Style="{StaticResource PrimaryButton}"
                Margin="0,0,8,0">Проверить все</Button>
        <Button x:Name="CancelCheckButton" Click="CancelCheck_Click" Visibility="Collapsed">Отменить</Button>
      </WrapPanel>
      <TextBlock x:Name="StatusText" Grid.Column="1" Margin="18,0" Foreground="{StaticResource MutedTextBrush}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Button Grid.Column="2" Click="Close_Click" IsCancel="True">Закрыть</Button>
    </Grid>
  </Grid>
</Window>
