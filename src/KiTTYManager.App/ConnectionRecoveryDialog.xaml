<Window x:Class="KiTTYManager.App.ConnectionRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Связь не восстановлена"
        Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <StackPanel Margin="22">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="15"/>
    <TextBlock Margin="0,14,0,6" Text="Продлить ожидание, минут"/>
    <TextBox x:Name="MinutesBox" MaxLength="5" ToolTip="Допустимо от 0 до 99999 минут"/>
    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
               Text="Больший основной таймаут можно задать в настройках приложения."/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Остановить задачу" Click="Stop_Click" Margin="0,0,8,0"/>
      <Button Content="Продолжить ожидание" Click="Continue_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
  </StackPanel>
</Window>
