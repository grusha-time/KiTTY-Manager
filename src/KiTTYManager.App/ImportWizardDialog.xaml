<Window x:Class="KiTTYManager.App.ImportWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KiTTYManager.App"
        Title="Импорт" Width="1050" Height="680" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}"
        Background="#101010" Foreground="#F0F0F0">
  <Grid Margin="18" Background="#101010">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Предварительный просмотр импорта" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="До нажатия «Импортировать» конфигурация не изменяется. Локальные записи не удаляются."
                 Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
               ToolTip="Ищет в открытой вкладке по названиям, группам и пояснениям"/>
    </DockPanel>

    <TabControl x:Name="ImportTabs" Grid.Row="2" SelectionChanged="ImportTabs_SelectionChanged" Background="#101010">
      <TabItem Header="Сессии">
        <DataGrid x:Name="SessionsGrid" ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" CurrentCellChanged="PlanGrid_Changed"
                  CanUserAddRows="False" Margin="8">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Текущая сессия" Binding="{Binding CurrentDisplay}" Width="1.5*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Импортируемая сессия" Binding="{Binding IncomingDisplay}" Width="1.5*" IsReadOnly="True"/>
            <DataGridTemplateColumn Width="150">
              <DataGridTemplateColumn.Header>
                <TextBlock Text="В группу из файла"
                           ToolTip="После импорта сессия окажется в той группе, где она лежит в файле. Снимите галочку, чтобы сессия осталась в своей текущей группе."/>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding UseIncomingGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Отмечено полей" Binding="{Binding CheckedFields}" Width="115" IsReadOnly="True"/>
            <DataGridTextColumn Header="Почему" Binding="{Binding Reason}" Width="1.2*" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Решение" Width="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{x:Static local:ImportChoices.Decisions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                            SelectedValue="{Binding Decision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Поля сессий">
        <DataGrid x:Name="FieldsGrid" ItemsSource="{Binding Fields}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="8" CurrentCellChanged="PlanGrid_Changed">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Сессия" Binding="{Binding SessionName}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Поле" Binding="{Binding Label}" Width="170" IsReadOnly="True"/>
            <DataGridTextColumn Header="Текущее" Binding="{Binding CurrentValue}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Из файла" Binding="{Binding IncomingValue}" Width="*" IsReadOnly="True"/>
            <DataGridTemplateColumn Width="125">
              <DataGridTemplateColumn.Header>
                <TextBlock Text="Взять из файла"
                           ToolTip="Заменить это поле значением из файла при импорте. Работает для сессий с решением «Оставить текущую»."/>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding UseIncoming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Группы">
        <DataGrid x:Name="GroupsGrid" ItemsSource="{Binding Groups}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="8" CurrentCellChanged="PlanGrid_Changed">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Группа импорта" Binding="{Binding IncomingPath}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Похожая текущая" Binding="{Binding CurrentPath}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Совпало сессий" Binding="{Binding MatchedSessions}" Width="120" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Что сделать" Width="280">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{x:Static local:ImportChoices.Groups}" DisplayMemberPath="Name" SelectedValuePath="Value"
                            SelectedValue="{Binding Decision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Точки входа">
        <DataGrid x:Name="ProxyGrid" ItemsSource="{Binding Proxies}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="8" CurrentCellChanged="PlanGrid_Changed">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Сессия запуска" Binding="{Binding StartupName}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Совпадение" Binding="{Binding ConfidenceDisplay}" Width="170" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Решение" Width="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{x:Static local:ImportChoices.Decisions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                            SelectedValue="{Binding Decision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Связи">
        <DataGrid x:Name="LinksGrid" ItemsSource="{Binding Links}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="8" CurrentCellChanged="PlanGrid_Changed">
          <DataGrid.Columns>
            <DataGridTextColumn Header="От" Binding="{Binding FromName}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="К" Binding="{Binding ToName}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Пояснение" Binding="{Binding Reason}" Width="1.7*" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Решение" Width="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{x:Static local:ImportChoices.Decisions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                            SelectedValue="{Binding Decision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button Content="Выбрать новые" Click="SelectNew_Click" Margin="0,0,8,0"/>
        <Button Content="Ничего не добавлять" Click="SkipAll_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
        <Button Content="Импортировать" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Import_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
