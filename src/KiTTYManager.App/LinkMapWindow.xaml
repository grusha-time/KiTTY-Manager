<Window x:Class="KiTTYManager.App.LinkMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Карта связей" Width="1280" Height="780" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Background="#151515" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Карта связей" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="SummaryText" Margin="0,5,0,0"
                     Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="AddSessionButton" Click="AddSession_Click"
                  Margin="0,0,8,0" Visibility="Collapsed"
                  ToolTip="Добавить в проверку сессию, которой ещё нет на карте">
            Добавить сессию… ▾
          </Button>
          <Button x:Name="CheckSelectedButton" Click="CheckSelected_Click"
                  Margin="0,0,8,0" IsEnabled="False" Visibility="Collapsed">
            Проверить выбранные
          </Button>
          <Button x:Name="CheckModeButton" Click="CheckMode_Click" Margin="0,0,8,0"
                  ToolTip="Выбрать несколько сессий и проверить связи между каждой парой">
            Проверка связей
          </Button>
          <Button Click="ZoomOut_Click" Width="42" Padding="0" FontSize="20"
                  ToolTip="Уменьшить">−</Button>
          <TextBlock x:Name="ZoomText" Width="68" TextAlignment="Center"
                     VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
          <Button Click="ZoomIn_Click" Width="42" Padding="0" FontSize="20"
                  ToolTip="Увеличить">+</Button>
          <Button Click="Fit_Click" Margin="8,0,0,0" ToolTip="Показать всю карту">Вся карта</Button>
          <Button Click="Close_Click" Margin="8,0,0,0">Закрыть</Button>
        </WrapPanel>
      </Grid>
    </Border>

    <Popup x:Name="SessionPickerPopup" Grid.Row="0"
           PlacementTarget="{Binding ElementName=AddSessionButton}"
           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
           PopupAnimation="Fade">
      <Border Width="470" MaxHeight="470" Margin="0,6,0,0" Padding="12"
              Background="#1C1C1C" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Выбрать сессии для проверки"
                     FontSize="16" FontWeight="SemiBold"/>
          <TextBox x:Name="SessionSearchBox" Grid.Row="1" Margin="0,10,0,8"
                   TextChanged="SessionSearchBox_TextChanged"
                   PreviewKeyDown="SessionSearchBox_PreviewKeyDown"
                   ToolTip="Поиск по имени, IP, логину или группе"/>
          <Grid Grid.Row="2">
            <ListBox x:Name="SessionChoicesList" MinHeight="120" MaxHeight="350"
                     SelectionMode="Multiple" SelectionChanged="SessionChoicesList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Details}" Margin="0,3,0,0"
                               FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoSessionChoicesText" Text="Ничего не найдено"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
          </Grid>
        </Grid>
      </Border>
    </Popup>

    <Grid x:Name="MapViewport" Grid.Row="1" Background="#111318" ClipToBounds="True"
          PreviewMouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
          PreviewMouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
          PreviewMouseMove="MapViewport_MouseMove"
          PreviewMouseWheel="MapViewport_MouseWheel"
          MouseLeave="MapViewport_MouseLeave">
      <Canvas x:Name="GraphCanvas" RenderTransformOrigin="0,0">
        <Canvas.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="GraphScale"/>
            <TranslateTransform x:Name="GraphTranslate"/>
          </TransformGroup>
        </Canvas.RenderTransform>
      </Canvas>

      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center"
                  VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="Связей пока нет" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>
        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}"
                   Text="На карте появятся сессии, связанные хотя бы с одной другой сессией."/>
      </StackPanel>

      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
              Background="#CC1A1A1A" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="7" Padding="12,8"
              IsHitTestVisible="False">
        <StackPanel>
          <TextBlock Foreground="{StaticResource MutedTextBrush}"
                     Text="Перетаскивание — двигать карту · Колесо — масштаб · Проверка связей — множественный выбор"/>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <Rectangle Width="22" Height="3" Fill="#4F8CFF" VerticalAlignment="Center"/>
            <TextBlock Margin="7,0,14,0" Text="доступна" Foreground="{StaticResource MutedTextBrush}"/>
            <Rectangle Width="22" Height="3" Fill="#D68A2E" VerticalAlignment="Center"/>
            <TextBlock Margin="7,0,0,0" Text="нет подтверждённого успеха"
                       Foreground="{StaticResource MutedTextBrush}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
