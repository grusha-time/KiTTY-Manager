<UserControl x:Class="KiTTYManager.App.SecretBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="38"/>
    </Grid.ColumnDefinitions>
    <PasswordBox x:Name="HiddenBox" Grid.Column="0" Margin="0" PasswordChanged="HiddenBox_PasswordChanged"
                 GotKeyboardFocus="SecretBox_GotKeyboardFocus" PreviewKeyDown="SecretBox_PreviewKeyDown">
      <PasswordBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Отменить" Command="ApplicationCommands.Undo"/>
          <Separator/>
          <MenuItem Header="Вырезать" Command="ApplicationCommands.Cut"/>
          <MenuItem Header="Копировать" Command="ApplicationCommands.Copy"/>
          <MenuItem Header="Вставить" Command="ApplicationCommands.Paste"/>
          <MenuItem Header="Выбрать всё" Command="ApplicationCommands.SelectAll"/>
        </ContextMenu>
      </PasswordBox.ContextMenu>
    </PasswordBox>
    <TextBox x:Name="VisibleBox" Grid.Column="0" Margin="0" Visibility="Collapsed" TextChanged="VisibleBox_TextChanged"/>
    <Button x:Name="RevealButton" Grid.Column="1" Margin="4,0,0,0" Padding="0" MinHeight="0"
            Click="RevealButton_Click" ToolTip="Показать пароль" AutomationProperties.Name="Показать пароль">
      <Viewbox Width="18" Height="18">
        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M 1,8 C 4,3 12,3 15,8 C 12,13 4,13 1,8 M 6,8 A 2,2 0 1 0 10,8 A 2,2 0 1 0 6,8"/>
      </Viewbox>
    </Button>
  </Grid>
</UserControl>
