<Window x:Class="KiTTYManager.App.SessionNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Width="560" Height="420" MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="ServerNameText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
               Text="Заметка хранится как обычный текст и не выполняется."/>
    <TextBox x:Name="NoteBox" Grid.Row="2" Margin="0,14,0,12"
             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             VerticalContentAlignment="Top" MinHeight="180"/>
    <TextBlock Grid.Row="3" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
               Text="Переносы строк, отступы и вставленные команды сохраняются как обычный текст."/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button IsCancel="True" Margin="0,0,8,0">Отмена</Button>
      <Button Click="Save_Click" Style="{StaticResource PrimaryButton}">Сохранить</Button>
    </StackPanel>
  </Grid>
</Window>
