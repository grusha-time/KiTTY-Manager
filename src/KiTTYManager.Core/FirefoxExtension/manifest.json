{
  "manifest_version": 2,
  "name": "KiTTY Manager Containers",
  "version": "0.1.0",
  "browser_specific_settings": {"gecko": {"id": "containers@kitty-manager.local", "strict_min_version": "128.0"}},
  "permissions": ["<all_urls>", "proxy", "tabs", "cookies", "contextualIdentities", "storage", "webRequest", "webRequestBlocking"],
  "background": {"scripts": ["config.js", "background.js"]}
}
